{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIY Browser",
  "version": "0.1.0",
  "identifier": "dev.diybrowser.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DIY Browser",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Browser dengan adblocker bawaan",
    "longDescription": "Browser desktop lintas OS dengan UI ala Arc dan adblocker ala Brave."
  }
}
